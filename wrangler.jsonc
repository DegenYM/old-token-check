{
  // Static site served by Cloudflare Workers (static assets). Build first: ./tools/build.sh
  "name": "old-token-check",
  "compatibility_date": "2026-09-26",
  "routes": [
    { "pattern": "oldtokencheck.com", "custom_domain": true },
    { "pattern": "www.oldtokencheck.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
